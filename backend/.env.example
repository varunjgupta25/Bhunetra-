# ==============================================================================
# BHUNETRA BACKEND - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Values below are the PRODUCTION settings. For local development copy this file
# to .env and switch to: ENVIRONMENT=development, DEBUG=True and (optionally)
# ALLOW_DEV_AUTH_BYPASS=True. Never commit the real .env file.

# Application Environment
ENVIRONMENT=production
PORT=8000
DEBUG=False

# Security & CORS
# Comma-separated list of allowed browser origins. The SPA is served by FastAPI on
# the same origin, so in production list only your public URL(s).
# Local dev example: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ORIGINS=https://bhunetra.example.com

# Firebase Cloud Connection
# Path to the service account JSON. In production, add it as a SECRET FILE
# (e.g. Render "Secret Files" -> /etc/secrets/firebase-adminsdk.json) - never bake it into the image.
FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-adminsdk.json
# Your Firebase Storage Bucket Name (e.g., your-project-id.appspot.com)
FIREBASE_STORAGE_BUCKET=bhunetra-sih.appspot.com
# true = refuse to start if Firebase cannot be initialized (otherwise an in-memory
# mock Firestore is used and ALL data is lost on restart)
REQUIRE_FIREBASE=true
# Accept mock dev tokens ("admin", "dev-admin-token", ...). Only honoured when
# ENVIRONMENT != production. Keep False in production.
ALLOW_DEV_AUTH_BYPASS=False

# Uploaded documents are stored on local disk in backend/uploads
# (/app/backend/uploads inside the Docker image). Mount a PERSISTENT DISK there,
# otherwise uploads are lost on every redeploy/restart.

# Bhashini OCR API Credentials (https://bhashini.gov.in)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Groq LLM API Credentials (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback Google Cloud Vision API Key (Optional)
GOOGLE_VISION_API_KEY=

# Pipeline Confidence Settings
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.75
