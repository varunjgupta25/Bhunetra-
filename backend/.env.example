# ==============================================================================
# BHUNETRA BACKEND - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Security & CORS (Frontend integration URLs)
# Add your frontend URLs separated by commas (e.g. React/Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Firebase Cloud Connection
# Path to your downloaded service account JSON file from Firebase Console
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
# Your Firebase Storage Bucket Name (e.g., your-project-id.appspot.com)
FIREBASE_STORAGE_BUCKET=bhunetra-sih.appspot.com
# Set to True to allow mock authentication in local dev if Firebase is not yet configured
ALLOW_DEV_AUTH_BYPASS=True

# Bhashini OCR API Credentials (https://bhashini.gov.in)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Groq LLM API Credentials (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback Google Cloud Vision API Key (Optional)
GOOGLE_VISION_API_KEY=

# Pipeline Confidence Settings
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.75
